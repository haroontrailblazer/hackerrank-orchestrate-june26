# Copy to .env and fill in. NEVER commit real keys.
# The offline "mock" provider requires no keys and runs the full pipeline.

# Provider: mock | anthropic | openai
ARGUS_PROVIDER=mock

# --- Anthropic (default real provider) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ARGUS_VISION_MODEL=claude-opus-4-8       # or claude-haiku-4-5 to cut cost ~5x
# ARGUS_REASONING_MODEL=claude-haiku-4-5

# --- OpenAI (alternative, for model comparison) ---
# OPENAI_API_KEY=sk-...
# ARGUS_VISION_MODEL=gpt-4o
# ARGUS_REASONING_MODEL=gpt-4o-mini

# --- Tuning ---
# ARGUS_ADJUDICATOR=rules        # rules | llm
# ARGUS_MAX_IMAGE_EDGE=1024      # downscale long edge to control image tokens
# ARGUS_MAX_WORKERS=4            # concurrent claims (RPM control)
# ARGUS_VISION_CACHE=1           # per-image content-hash cache
# ARGUS_PROMPT_CACHE=1           # Anthropic prompt caching of the system prefix
