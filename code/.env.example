# Copy to .env and fill in. NEVER commit real keys.
# The offline "mock" provider requires no keys and runs the full pipeline.

# Provider: mock | anthropic | openai
ARGUS_PROVIDER=mock

# --- Anthropic (default real provider) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ARGUS_VISION_MODEL=claude-opus-4-8       # or claude-haiku-4-5 to cut cost ~5x
# ARGUS_REASONING_MODEL=claude-haiku-4-5

# --- OpenAI (alternative, for model comparison) ---
# OPENAI_API_KEY=sk-...
# ARGUS_VISION_MODEL=gpt-4o
# ARGUS_REASONING_MODEL=gpt-4o-mini

# --- NVIDIA NIM / API Catalog (OpenAI-compatible VLMs) ---
# Get a key at build.nvidia.com (prefix nvapi-). Pick the exact, current vision
# model slug there (the catalog changes); default below is a stable fallback.
# NVIDIA_API_KEY=nvapi-...
# ARGUS_PROVIDER=nvidia
# ARGUS_VISION_MODEL=meta/llama-3.2-90b-vision-instruct   # or a newer qwen/kimi/minimax VLM
# ARGUS_REASONING_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1     # or http://localhost:8000/v1 for self-hosted NIM

# --- Tuning ---
# ARGUS_ADJUDICATOR=rules        # rules | llm
# ARGUS_FALLBACK=openai,anthropic,mock   # auto-fallback chain when a provider has no key/fails
#                                        # (set to e.g. "openai" to disable the offline mock net)
# ARGUS_MAX_IMAGE_EDGE=1024      # downscale long edge to control image tokens
# ARGUS_MAX_WORKERS=4            # concurrent claims
# --- resilience harness (per-agent-step controls) ---
# ARGUS_RPM=0                    # rate-limit model calls/min (0 = unlimited)
# ARGUS_STEP_TIMEOUT=180         # per-agent-step wall-clock cap (seconds)
# ARGUS_STEP_RETRIES=2           # step-level retries (on top of SDK network retries)
# ARGUS_CIRCUIT_THRESHOLD=5      # open circuit after N consecutive step failures
# ARGUS_CIRCUIT_RESET=30         # circuit cooldown before a half-open trial (seconds)
# ARGUS_VISION_CACHE=1           # per-image content-hash cache
# ARGUS_PROMPT_CACHE=1           # Anthropic prompt caching of the system prefix
